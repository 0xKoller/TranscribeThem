{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.5.0",
  "minimum_chrome_version": "113",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extActionTitle__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "transcribe-latest": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "__MSG_cmdTranscribeLatest__"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "offscreen", "unlimitedStorage", "downloads", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://web.whatsapp.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/extract-match.js", "src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/i18n.js", "src/messages.js", "src/settings.js", "src/errors.js", "src/ui-mount.js", "src/words.js", "src/transcript-cache.js", "src/content-core.js", "src/content-features.js", "src/content-whatsapp.js", "src/content-main.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"],
      "js": ["src/extract-match.js", "src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"],
      "js": ["src/i18n.js", "src/messages.js", "src/settings.js", "src/errors.js", "src/ui-mount.js", "src/words.js", "src/x-find.js", "src/transcript-cache.js", "src/content-core.js", "src/content-features.js", "src/content-whatsapp.js", "src/content-x.js", "src/content-main.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
